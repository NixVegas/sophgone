/*
 * Default environment of the Milk-V Duo S U-Boots, both cores, in U-Boot's
 * text environment format (doc/usage/environment.rst): name=value, with
 * indented continuation lines joined by one space. package.nix runs it
 * through the C preprocessor with the board's config (so CONFIG_ symbols
 * work) and NIXBADGE_CORE=arm|riscv, then through env2string.awk, into
 * include/generated/nixbadge-env.h. The preprocessor passes `#` lines
 * through as text, so comments are C-style.
 *
 * bootcmd runs nixbadge_boot:
 *
 * - on a gpt-squashfs card (partition 3 exists) nixbadge_walk picks a RAUC
 *   slot (nixbadge_slot: BOOT_ORDER, BOOT_<s>_LEFT; with none left both are
 *   re-armed and A boots with A_LEFT=2, this boot being one of its tries)
 *   and runs nixbadge_try. If that returns, the slot is marked bad and the
 *   other slot is tried. nixbadge_try re-derives nixpart/nixroot with
 *   rauc_slot, since each slot's vbmeta carries its own verity root hash.
 * - nixbadge_legacy runs last on every card: sysboot of
 *   /<core>/extlinux/extlinux.conf, the only path on an ext4-mbr card. It
 *   clears rauc_slot before btnsel so a held button picks the legacy
 *   -desktop/-video conf, then sets rauc_slot=A (never B) if partition 3
 *   exists, since the legacy conf on a gpt card is slot A's copy. Its
 *   sysboots are chained with `;`, not `||`: do_sysboot() returns 0 even
 *   when the label it tried fails to boot. Where sysboot is not built in
 *   (the secure build) it only prints "nixbadge: no slot booted" and runs
 *   nixbadge_halt, which idles: returning would drop to the command line.
 *
 * Nothing here resets: a reset would rerun the same walk against the same
 * card. A missing partition leaves $nixroot empty and the walk goes on.
 * nixbadge_try also runs btnsel, which sets $target (default, desktop with
 * BOOT held, video with USER held) and $bootconf.
 *
 * nixbadge_fit boots a slot from /<core>/slot-<s>/: it clears $verityargs,
 * loads vbmeta.itb at $vbaddr and sources its "frag" script (which sets
 * $verityargs; the boot fails if it stays empty), loads boot.itb at
 * $loadaddr, then sources script-<target> if the FIT has one (`fdt get`)
 * and finally script-default. Any failure returns, so the walk moves on.
 * The secure build's control DTB carries the sg1-image key twice
 * (fit-key-dtb.nix), required = "conf" and required = "image": `source`
 * runs a script only after fit_image_verify(), and bootm checks the
 * configuration signature and every image it loads. The plain build checks
 * hashes only.
 *
 * A profile script script-<p> runs with $verityargs, $rauc_slot, $rauc_ext,
 * $bootmedium, $loadaddr, $vbaddr, $target and $nixroot set. It sets
 * $bootargs and ends with `bootm ${loadaddr}#conf-<p>` (script-default
 * always boots conf-default), then `false` if bootm returns. The script text
 * must not end in a newline: this hush returns the status of the last
 * statement parsed, and a trailing newline adds an empty one with status 0.
 *
 * $rauc_ext is "rauc.external" on an SD boot (board_late_init,
 * cvi-env-medium.c), so RAUC treats every eMMC slot as inactive there.
 * nixbadge_envpick imports only the four write-listed names: `env import -c`
 * ignores CONFIG_ENV_WRITEABLE_LIST. nixbadge_envfallback reads 0x200 blocks
 * (both redundant 0x20000 copies) to 0x82000000, which sysboot overwrites
 * before using it as scriptaddr.
 *
 * Load map: kernel 0x81000000, scriptaddr 0x82000000, fdt and vbaddr
 * 0x88000000, initrd and loadaddr 0x8a000000 (sysboot needs the _r
 * addresses; images inside boot.itb carry their own). All clear of U-Boot
 * text (0x80200000) and ION (0x9A600000).
 *
 * No mmcdev/bootmedium default here: board_late_init() (cvi-env-medium.c)
 * sets both from the FSBL's boot-source flag, before bootcmd runs.
 */
scriptaddr=0x82000000
kernel_addr_r=0x81000000
fdt_addr_r=0x88000000
ramdisk_addr_r=0x8a000000
core=NIXBADGE_CORE
vbaddr=0x88000000
loadaddr=0x8a000000

nixbadge_envpick=
    setexpr.b nb_f0 *0x82000004; setexpr.b nb_f1 *0x82020004;
    setenv nb_first 0x82000000; setenv nb_second 0x82020000;
    if test 0x${nb_f0} -eq 0xff -a 0x${nb_f1} -eq 0; then
        setenv nb_first 0x82020000; setenv nb_second 0x82000000;
    elif test 0x${nb_f1} -eq 0xff -a 0x${nb_f0} -eq 0; then
        true;
    elif test 0x${nb_f1} -gt 0x${nb_f0}; then
        setenv nb_first 0x82020000; setenv nb_second 0x82000000;
    fi;
    env import -c ${nb_first} 0x20000 BOOT_ORDER BOOT_A_LEFT BOOT_B_LEFT env_loaded ||
    env import -c ${nb_second} 0x20000 BOOT_ORDER BOOT_A_LEFT BOOT_B_LEFT env_loaded ||
    echo nixbadge: UBOOT seed copy bad too, using defaults

nixbadge_slot=
    setenv rauc_slot;
    test -n "${BOOT_ORDER}" || setenv BOOT_ORDER A B;
    test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3;
    test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3;
    for s in ${BOOT_ORDER}; do
        if test -n "${rauc_slot}"; then
            true;
        elif test "${s}" = A -a ${BOOT_A_LEFT} -gt 0; then
            setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; setenv rauc_slot A;
        elif test "${s}" = B -a ${BOOT_B_LEFT} -gt 0; then
            setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; setenv rauc_slot B;
        fi;
    done;
    if test -z "${rauc_slot}"; then
        echo nixbadge: no slot has attempts left, re-arming both and booting A;
        setenv BOOT_A_LEFT 2; setenv BOOT_B_LEFT 3; setenv rauc_slot A;
    fi;
    setenv env_loaded 1; saveenv

nixbadge_try=
    if test "${rauc_slot}" = B; then setenv nixpart 4; else setenv nixpart 3; fi;
    if part uuid mmc ${mmcdev}:${nixpart} nixroot; then
        echo nixbadge: medium ${bootmedium} slot ${rauc_slot} root ${nixroot};
    else
        echo nixbadge: no partition ${nixpart} on mmc ${mmcdev}; setenv nixroot;
    fi;
    btnsel; run nixbadge_fit

nixbadge_fit=
    setenv verityargs;
    if load mmc ${mmcdev}:1 ${vbaddr} /${core}/slot-${rauc_slot}/vbmeta.itb; then
        source ${vbaddr}:frag;
    else
        echo nixbadge: slot ${rauc_slot} has no vbmeta; false;
    fi &&
    test -n "${verityargs}" &&
    load mmc ${mmcdev}:1 ${loadaddr} /${core}/slot-${rauc_slot}/boot.itb &&
    if test "${target}" = default; then
        source ${loadaddr}:script-default;
    else
        if fdt addr ${loadaddr} && fdt get value nb_type /images/script-${target} type; then
            source ${loadaddr}:script-${target};
            echo nixbadge: script-${target} did not boot, trying script-default;
        else
            echo nixbadge: no script-${target};
        fi;
        source ${loadaddr}:script-default;
    fi

nixbadge_boot=
    if test "${bootmedium}" = 1; then sdready; fi;
    if part uuid mmc ${mmcdev}:3 nixroot; then
        run nixbadge_walk;
    else
        echo nixbadge: no partition 3 on mmc ${mmcdev}, not a gpt-squashfs card, skipping the A/B walk;
    fi;
    run nixbadge_legacy

nixbadge_walk=
    if test -z "${env_loaded}"; then
        echo nixbadge: no stored env on medium ${bootmedium};
        if test "${bootmedium}" = 0; then run nixbadge_envfallback; fi;
    fi;
    run nixbadge_slot; run nixbadge_try;
    echo nixbadge: slot ${rauc_slot} did not boot, marking it bad and trying the other;
    if test "${rauc_slot}" = A; then
        setenv BOOT_A_LEFT 0; setenv rauc_slot B;
    else
        setenv BOOT_B_LEFT 0; setenv rauc_slot A;
    fi;
    saveenv; run nixbadge_try

/* The legacy extlinux tail and its conf default, only where sysboot exists. */
#ifdef CONFIG_CMD_SYSBOOT
bootconf=/NIXBADGE_CORE/extlinux/extlinux.conf
nixbadge_legacy=
    setenv rauc_slot; setenv nixpart 3;
    if part uuid mmc ${mmcdev}:${nixpart} nixroot; then true; else setenv nixroot; fi;
    setenv bootconf /${core}/extlinux/extlinux.conf; btnsel;
    if test -n "${nixroot}"; then setenv rauc_slot A; fi;
    sysboot mmc ${mmcdev}:1 any ${scriptaddr} ${bootconf};
    sysboot mmc ${mmcdev}:1 any ${scriptaddr} /${core}/extlinux/extlinux.conf
#else
nixbadge_legacy=echo nixbadge: no slot booted; nixbadge_halt
#endif

nixbadge_envfallback=
    mmc dev ${mmcdev} 0 && part start mmc ${mmcdev} UBOOT nb_ubs &&
    mmc read 0x82000000 ${nb_ubs} 200 && run nixbadge_envpick
