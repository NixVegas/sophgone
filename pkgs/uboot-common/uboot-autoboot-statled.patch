--- a/common/autoboot.c
+++ b/common/autoboot.c
@@ -21,6 +21,14 @@
 #include <time.h>
 #include <asm/global_data.h>
 #include <linux/delay.h>
+
+/* STAT LED during the countdown. Defined in pkgs/cvi-statled-early.c,
+ * appended to board/cvitek/cv181x/board.c, which has no header of its own.
+ * No weak fallback: a missing definition fails the link instead of silently
+ * dropping the indicator. */
+void statled_begin(void);
+void statled_toggle(void);
+void statled_end(void);
 #include <u-boot/sha256.h>
 #include <bootcount.h>
 #include <crypt.h>
@@ -234,6 +242,8 @@
 	};
 
 	char presskey[DELAY_STOP_STR_MAX_LENGTH];
+	const uint64_t statled_period = get_tbclk() / 8;  /* ~125ms per toggle */
+	uint64_t statled_next;
 	int presskey_len = 0;
 	int presskey_max = 0;
 	int i;
@@ -264,15 +274,36 @@
 	/* In order to keep up with incoming data, check timeout only
 	 * when catch up.
 	 */
+	statled_begin();
+	statled_next = get_ticks();
+
 	do {
+		/* Toggle off the tick count, never a delay: this loop polls the
+		 * console and must stay responsive. */
+		if (get_ticks() >= statled_next) {
+			statled_toggle();
+			statled_next = get_ticks() + statled_period;
+		}
+
 		if (tstc()) {
+			int ch = getchar();
+
+			/* ser2net / telnet send LF for Enter, a serial terminal
+			 * sends CR. Fold LF (including the LF of a CRLF) to CR so
+			 * a STOP_STR of "\r" is matched by Enter over either
+			 * transport. STOP_STR is a single char here, so this is
+			 * safe; it would only matter if a STOP_STR ever contained
+			 * a literal LF, which ours does not. */
+			if (ch == '\n')
+				ch = '\r';
+
 			if (presskey_len < presskey_max) {
-				presskey[presskey_len++] = getchar();
+				presskey[presskey_len++] = ch;
 			} else {
 				for (i = 0; i < presskey_max - 1; i++)
 					presskey[i] = presskey[i + 1];
 
-				presskey[i] = getchar();
+				presskey[i] = ch;
 			}
 		}
 
@@ -294,6 +325,8 @@
 		}
 	} while (!abort && get_ticks() <= etime);
 
+	statled_end();
+
 	return abort;
 }
 
